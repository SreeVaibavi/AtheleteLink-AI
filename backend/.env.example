# Database
DB_URL=jdbc:mysql://127.0.0.1:3306/athletelink_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=1234567

# JWT - replace with your own 32+ character secret for real deployments
JWT_SECRET=replace-with-a-random-32-character-secret

# Public URL used in application/booking confirmation links
PUBLIC_BASE_URL=http://localhost:8880

# Optional SMTP. Leave blank for local confirmation-link fallback.
# Gmail: use a Gmail App Password, not your normal account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-gmail-app-password
MAIL_FROM=your-gmail-address@gmail.com
